{
  "name": "dsh-image-prompt-forge",
  "version": "1.3.5",
  "type": "module",
  "description": "把想法拆成可直接执行的生图提示词：六种方言、参考图库（姿势/服装/人像）、粘贴板导入与图生图，并支持自带 OpenAI 兼容的生图端点（密钥只存本机）。",
  "license": "MIT",
  "author": "Vhow123",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt-engineering",
    "image-generation",
    "midjourney",
    "stable-diffusion",
    "gpt-image",
    "image-to-prompt",
    "image-to-image",
    "prompt-edit",
    "pose-reference",
    "controlnet",
    "reference-gallery",
    "bring-your-own-endpoint",
    "image-edits"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vhow123/dsh-prompt-forge.git"
  },
  "homepage": "https://github.com/Vhow123/dsh-prompt-forge#readme",
  "bugs": {
    "url": "https://github.com/Vhow123/dsh-prompt-forge/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./engine": "./engine.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./gallery": "./gallery.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check engine.js",
    "verify": "node test/bare-import.mjs && node test/client-contract.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.js",
    "gallery.js",
    "cordis.patch.yml",
    "README.md",
    "test/"
  ]
}
